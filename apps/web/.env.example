# Local development. Copy to .env.local (git-ignored); never commit a value.
#
# DATABASE_URL is read by drizzle-kit (`pnpm --filter @app/web db:generate`,
# db:push, db:studio), by `pnpm --filter @app/web db:migrate` (which applies
# lib/db/migrations to a local Postgres) and by the app only when no Cloudflare
# context is available. Under `next dev` and `wrangler dev` the app reads the
# HYPERDRIVE binding from wrangler.jsonc instead (its localConnectionString —
# point both at the same database). The database needs the `vector` extension
# available (README → Local development).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rag
# Vercel AI Gateway key (https://vercel.com/ai-gateway): `next dev` reads it
# from here, `wrangler dev` from .dev.vars.
AI_GATEWAY_API_KEY=sk***
